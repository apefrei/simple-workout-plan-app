# === PostgreSQL Database Configuration ===
POSTGRES_DB=workout_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# === JWT Secret (generate with: openssl rand -base64 32) ===
JWT_SECRET=your_jwt_secret_here_min_32_chars

# === API Backend Configuration ===
ALLOWED_ORIGINS=http://localhost:3000
# Public URL where the API is accessible (for media URLs in responses)
API_PUBLIC_URL=http://localhost:3001

# === Vite/React App Configuration ===
# BUILD-TIME variable — baked into the JS bundle by Vite during `docker-compose build`.
# Set to the public URL where the browser can reach the API (not the internal Docker network name).
# For local dev the default http://localhost:3001 works. For production set this before building:
#   export VITE_API_URL=https://api.yourdomain.com && docker-compose build
VITE_API_URL=http://localhost:3001

# === Cloudflare Turnstile (optional — for auth page protection) ===
# Leave blank to disable captcha in development
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Connection string (for tooling / migration scripts) ===
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/workout_planner
